---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvIntro from '../components/cv/CvIntro.astro';
import CvExperience from '../components/cv/CvExperience.astro';
import CvEducation from '../components/cv/CvEducation.astro';
import CvSkills from '../components/cv/CvSkills.astro';
import CvProjects from '../components/cv/CvProjects.astro';
import '../styles/cv.css';
---

<BaseLayout bodyClass="cv-page">
  <CvIntro />
  <div class="cv-grid">
    <CvExperience />
    <CvEducation />
    <CvSkills />
    <CvProjects />
  </div>
</BaseLayout>

<style>
  .cv-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* Full-width sections (Experience, Projects) carry the .cv-span class. */
  .cv-grid > :global(.cv-span) {
    grid-column: 1 / -1;
  }

  @media (max-width: 760px) {
    .cv-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .cv-grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      margin-top: 1rem;
    }

    .cv-grid > :global(.cv-span) {
      grid-column: auto;
    }
  }
</style>
