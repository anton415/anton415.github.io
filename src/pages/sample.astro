---
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = [
  {
    title: 'Общие шаблоны лежат в src/layouts',
    detail: 'Используйте их, чтобы структура и метаданные оставались единообразными.',
  },
  {
    title: 'Страницы лежат в src/pages',
    detail: 'Каждый файл .astro автоматически становится отдельным маршрутом.',
  },
  {
    title: 'TypeScript уже включён',
    detail: 'Если подключаете новые инструменты, синхронизируйте настройки в tsconfig.json.',
  },
];
---

<BaseLayout title="Пример">
  <section class="card">
    <h1>Тестовая страница</h1>
    <p>Используйте этот маршрут как черновик для новых секций и контента, прежде чем переносить их в рабочие страницы.</p>
    <div>
      {
        notes.map((note) => (
          <article style="margin-bottom: 1.5rem;">
            <strong>{note.title}</strong>
            <p>{note.detail}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
