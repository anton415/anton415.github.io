---
import { cv } from '../../data/cv';

const { education } = cv;
---

<article class="card">
  <h2>Образование</h2>
  <div class="cv-stack">
    {
      education.map((item) => (
        <div class="cv-item">
          <div class="cv-item-head">
            <div>
              <h3>{item.degree}</h3>
              <p class="cv-meta">{item.field}</p>
              <p class="cv-meta">{item.school}</p>
            </div>
            <span class="cv-dates">{item.year}</span>
          </div>
        </div>
      ))
    }
  </div>
</article>
