---
import { profile } from '../../data/profile';
import { cv } from '../../data/cv';

const { summary } = cv;
---

<section class="card hero" id="about">
  <p class="pill">{profile.name}</p>
  <h1>{profile.headline}</h1>
  <p class="lede">{profile.tagline}</p>
  <p class="location">{profile.location}</p>
  <div class="cv-actions screen-only">
    <a class="cv-action cv-action-primary" href="/Anton_Serdyuchenko_Software_Engineer_RU.pdf" download> Download CV (RU) </a>
    <button type="button" class="cv-action" data-print-button>Print / PDF</button>
  </div>
  <div class="summary-list">
    {summary.map((item) => <p>{item}</p>)}
  </div>
</section>

<script>
  // Bundled by Astro into a same-origin module, so it stays within a
  // `script-src 'self'` CSP (no inline handler / 'unsafe-inline' needed).
  document.querySelector('[data-print-button]')?.addEventListener('click', () => window.print());
</script>

<style>
  .hero h1 {
    margin: 0.6rem 0 0.4rem;
    font-size: clamp(2.1rem, 4vw, 2.8rem);
  }

  .lede {
    margin: 0 0 0.4rem;
    color: var(--ink-soft);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    max-width: 44rem;
  }

  .location {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .summary-list {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .summary-list p {
    margin: 0;
  }

  .cv-actions {
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .cv-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.4rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
    text-decoration: none;
  }

  .cv-action-primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .cv-action:not(.cv-action-primary) {
    border-color: rgba(61, 40, 20, 0.2);
    background: rgba(255, 255, 255, 0.45);
    color: var(--ink);
  }

  .cv-action:hover {
    transform: translateY(-1px);
  }

  @media print {
    /* :global ancestor raises specificity above the print.css .card flatten. */
    :global(body.cv-page) .hero {
      padding-bottom: 0.8rem;
      border-bottom: 1px solid rgba(61, 40, 20, 0.2);
    }

    .summary-list {
      gap: 0.3rem;
    }
  }
</style>
