---
import { cv } from '../../data/cv';

const { skills } = cv;

const groups = [
  { title: 'Core', items: skills.core },
  { title: 'Additional tools', items: skills.tools },
  { title: 'Languages', items: skills.languages },
];
---

<article class="card">
  <h2>Skills</h2>
  {
    groups.map((group) => (
      <div class="cv-section">
        <h3>{group.title}</h3>
        <div class="cv-chips">
          {group.items.map((item) => (
            <span class="cv-chip">{item}</span>
          ))}
        </div>
      </div>
    ))
  }
</article>
